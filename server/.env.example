# ============================================================
# AWE-OS Server — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Public URL of THIS backend (not the frontend) — used to build links that
# must be clicked directly against the API, e.g. newsletter unsubscribe links.
# In production, set this to the deployed backend URL (e.g. Render).
API_BASE_URL=http://localhost:5000

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Authentication ───────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-64-char-hex-jwt-secret

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your-openai-key

# ── Unsplash (optional — featured images for AI-generated blog posts) ────────
# Get a free access key at https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# ── Razorpay ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ── AWS S3 (optional — for file/product uploads) ─────────────
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-bucket-name
AWS_BUCKET_NAME=your-bucket-name

# ── Email (optional — required for password reset emails) ────
# Supported: Resend (preferred), or add your own provider
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com

# ── Client-side env vars (exposed to Vite/React) ─────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_URL=http://localhost:5000
VITE_RAZORPAY_KEY_ID=rzp_test_...
VITE_ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXX

# -- Redis (required for BullMQ job queues) -----------------------------------
# Local: redis://127.0.0.1:6379
# Cloud: redis://default:<password>@<host>:<port>
REDIS_URL=redis://127.0.0.1:6379

# -- Pipeline rate limiting ---------------------------------------------------
# Maximum manual pipeline triggers per admin per minute
PIPELINE_MAX_TRIGGERS_PER_MIN=5

# -- AI Cost Control ----------------------------------------------------------
# Daily OpenAI token budget. Idea generation stops when limit is reached.
# Default: 500000 (approx $1.50/day at gpt-4o-mini rates)
OPENAI_DAILY_TOKEN_LIMIT=500000

# -- Alerting thresholds ------------------------------------------------------
# Pipeline health dashboard shows alert banner above this failure rate (0-1)
ALERT_FAILURE_RATE_THRESHOLD=0.20
# Circuit breaker trips when failure rate exceeds this in last 10 jobs (0-1)
CIRCUIT_BREAKER_THRESHOLD=0.50
